# ==============================================================================
# OneHopz — Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env` (or `Copy-Item .env.example .env` in PowerShell).
# 2. Never commit .env to version control. All secrets must remain local or injected via secret managers.
# ==============================================================================

# --- Global / Environment Settings ---
ONEHOPZ_ENV=development
DEBUG=True
SECRET_KEY=onehopz-dev-insecure-secret-key-replace-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# --- PostgreSQL & PostGIS Configuration ---
# Used by PostgreSQL container and Django backend
POSTGRES_DB=onehopz_dev
POSTGRES_USER=onehopz_user
POSTGRES_PASSWORD=onehopz_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# In local development outside Docker, you can point to localhost:
# POSTGRES_HOST=localhost

# --- Redis Configuration ---
# Used for ephemeral cache, rate limiting, and Celery broker/backend
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# In local development outside Docker:
# REDIS_HOST=localhost
# REDIS_URL=redis://localhost:6379/0

# --- Celery Configuration ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Django Backend Configuration ---
DJANGO_SETTINGS_MODULE=config.settings
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Next.js Frontend Configuration ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
